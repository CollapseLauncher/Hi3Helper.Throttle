<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;netstandard2.1</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <PlatformTarget>x64</PlatformTarget>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Platforms>x64</Platforms>
        <DefineConstants>CompileNative</DefineConstants>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <DefineConstants>$(DefineConstants);WIN32</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="$(DefineConstants.Contains('CompileNative'))">
        <DefineConstants>$(DefineConstants);UseDllMainWorkaround</DefineConstants>
        <TargetFrameworks>net11.0</TargetFrameworks>
        <!-- .NET 11 feature - Runtime Async -->
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="publish\**" />
        <EmbeddedResource Remove="publish\**" />
        <None Remove="publish\**" />
    </ItemGroup>

    <ItemGroup Condition="$(DefineConstants.Contains('UseDllMainWorkaround'))">
      <PackageReference Include="NativeDllMain" Version="1.0.0" />
    </ItemGroup>

</Project>